{
  "name": "heraja-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/fetch-site-content.mjs && node scripts/generate-sitemap.mjs && node scripts/check-links.mjs && node scripts/check-redirects.mjs",
    "build": "tsc -b && vite build",
    "generate-assets": "node scripts/generate-assets.mjs",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0 --port ${PORT:-4173}",
    "check:links": "node scripts/check-links.mjs",
    "check:redirects": "node scripts/check-redirects.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:all": "node scripts/check-links.mjs && node scripts/check-redirects.mjs",
    "content:fetch": "node scripts/fetch-site-content.mjs",
    "check:tone": "node scripts/check-tone.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "kimi-plugin-inspect-react": "^1.0.3",
    "postcss": "^8.5.6",
    "sharp": "^0.34.4",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  },
  "description": "heraja.com — Heraja Agro Technologies corporate site."
}
