# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored by default in Vite projects.

# URL of a webhook (Zapier, Make, n8n, or your own endpoint) that receives
# contact form submissions as a POST with a JSON body. If left unset, the
# Contact page form will show a "not connected yet" message instead of
# silently failing.
VITE_CONTACT_WEBHOOK_URL=

# Umami analytics — cookieless, self-hosted, off unless BOTH are set.
#
# Chosen because it needs no consent banner (a meaningful share of this
# site's audience is government and development organisations, where a
# cookie dialogue opens a data-handling conversation at first contact) and
# because self-hosting means the traffic data lives on Heraja's own
# infrastructure rather than a third party's.
#
# Deploy Umami (umami.is — MIT licensed, runs on Railway against Postgres
# or MySQL), add the site, then paste its script URL and website id here.
# Unset on previews, forks and local dev: nothing is collected and no
# third-party script is injected.
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=

# ─────────────────────────────────────────────────────────────────────────────
# CONTACT INTEGRATION CONTRACT
#
# VITE_CONTACT_WEBHOOK_URL above is the single integration point between this
# site and wherever enquiries are handled. It is consumed only by
# src/lib/contact.ts; no component talks to a backend directly, so replacing
# the transport is a change to that one file.
#
# The endpoint receives:
#
#   POST <VITE_CONTACT_WEBHOOK_URL>
#   Content-Type: application/json
#
#   {
#     "first_name":   string,
#     "last_name":    string,
#     "email":        string,
#     "organization": string,
#     "enquiry_type": "government" | "financial-institution" | "cooperative"
#                   | "agribusiness" | "development-organization"
#                   | "technology-partner" | "careers" | "other",
#     "country":      string,   // ISO 3166-1 alpha-2, e.g. "NG"
#     "message":      string,
#     "source":       "website_contact_form",
#     "page_url":     string,
#     "submitted_at": string    // ISO 8601
#   }
#
# Any 2xx is treated as delivered. Any other status, or a network failure,
# shows the visitor a retry plus a mailto fallback with their input preserved.
#
# REQUIREMENT ON WHATEVER SERVES THIS URL: it must be safe to call
# unauthenticated. This is a static site — every VITE_* value is inlined into
# the published bundle, so this URL is public and cannot carry a secret. The
# endpoint therefore needs its own rate limiting and spam protection, and must
# NOT be an authenticated HAOS API reached with a machine credential; that
# credential would ship to every visitor.
#
# If authentication is required, the transport has to move server-side.
# src/lib/contact.ts is the only file that would change.
#
# Unset (the current state): the form does not pretend to submit. It says so
# before anyone types and points at the fallback address.
